    {
      "id": "i6",
      "parent": "i1",
      "kind": "page",
      "title": "Ask your news",
      "icon": "📰",
      "content": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph"
          }
        ]
      },
      "flow": {
        "name": "news.ask",
        "title": "Ask your news",
        "description": "A question (input question) answered from the news Zeff has fetched, citing numbered sources. Output { answer, sources }.",
        "inputs": [],
        "nodes": [
          {
            "id": "a",
            "kind": "action",
            "action": "lambda.invoke",
            "input": {
              "name": "news.ask",
              "event": {
                "question": "{{ input.question }}"
              }
            }
          },
          {
            "id": "done",
            "kind": "return",
            "value": {
              "answer": "{{ steps.a.answer }}",
              "sources": "{{ steps.a.sources }}",
              "error": "{{ steps.a.error }}"
            }
          }
        ],
        "requested": {
          "ai": true
        },
        "triggers": [
          {
            "kind": "manual"
          }
        ]
      }
    },
    {
      "id": "i3",
      "parent": "i1",
      "kind": "page",
      "title": "Do something with the news",
      "icon": "📰",
      "content": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph"
          }
        ]
      },
      "flow": {
        "name": "news.act",
        "title": "Do something with the news",
        "description": "op state (id, state: new|read|saved|hidden), vote (id, value 1|0|-1), seen (ids), source-add (url, name, category, lang), source-update (id, name, enabled, weight), source-remove (id), forget, clean. Run by the News screens.",
        "inputs": [],
        "nodes": [
          {
            "id": "do",
            "kind": "action",
            "action": "lambda.invoke",
            "input": {
              "name": "news.act",
              "event": {
                "op": "{{ input.op }}",
                "id": "{{ input.id }}",
                "state": "{{ input.state }}",
                "value": "{{ input.value }}",
                "ids": "{{ input.ids }}",
                "url": "{{ input.url }}",
                "name": "{{ input.name }}",
                "category": "{{ input.category }}",
                "lang": "{{ input.lang }}",
                "enabled": "{{ input.enabled }}",
                "weight": "{{ input.weight }}",
                "text": "{{ input.text }}"
              }
            }
          },
          {
            "id": "write",
            "kind": "if",
            "when": "{{ steps.do.ok }}",
            "then": [
              {
                "id": "sql",
                "kind": "action",
                "action": "sql.exec",
                "input": {
                  "statements": "{{ steps.do.statements }}"
                }
              },
              {
                "id": "signal",
                "kind": "if",
                "when": "{{ steps.do.taste }}",
                "then": [
                  {
                    "id": "queue",
                    "kind": "action",
                    "action": "pref.set",
                    "input": {
                      "plugin": "news-ext",
                      "key": "news:taste",
                      "value": "{{ steps.do.taste }}"
                    }
                  }
                ],
                "else": []
              }
            ],
            "else": []
          },
          {
            "id": "again",
            "kind": "if",
            "when": "{{ input.rescore }}",
            "then": [
              {
                "id": "rs",
                "kind": "action",
                "action": "lambda.invoke",
                "input": {
                  "name": "news.rescore",
                  "event": {}
                }
              },
              {
                "id": "rsw",
                "kind": "foreach",
                "items": "{{ steps.rs.batches }}",
                "as": "b",
                "nodes": [
                  {
                    "id": "rsx",
                    "kind": "action",
                    "action": "sql.exec",
                    "input": {
                      "statements": "{{ b }}"
                    }
                  }
                ],
                "max": 200
              }
            ],
            "else": []
          },
          {
            "id": "done",
            "kind": "return",
            "value": {
              "ok": "{{ steps.do.ok }}",
              "error": "{{ steps.do.error }}"
            }
          }
        ],
        "requested": {
          "write": "all",
          "store": [
            "news-ext.sources",
            "news-ext.items",
            "news-ext.gone",
            "news-ext.terms",
            "news-ext.similar"
          ]
        },
        "triggers": [
          {
            "kind": "manual"
          }
        ]
      }
    },
    {
      "id": "i2",
      "parent": "i1",
      "kind": "page",
      "title": "Fetch the news",
      "icon": "📰",
      "content": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph"
          }
        ]
      },
      "flow": {
        "name": "news.fetch-round",
        "title": "Fetch the news — one round",
        "description": "The feeds due are fetched (the ones fetched longest ago first), what is new is kept, everything recent is scored for you. Input all: every due feed, onlyIds: just those.",
        "inputs": [],
        "nodes": [
          {
            "id": "soft4",
            "kind": "try",
            "nodes": [
              {
                "id": "find",
                "kind": "action",
                "action": "lambda.invoke",
                "input": {
                  "name": "news.auto-discover",
                  "event": {}
                }
              },
              {
                "id": "found",
                "kind": "foreach",
                "items": "{{ steps.find.batches }}",
                "as": "b",
                "nodes": [
                  {
                    "id": "foundw",
                    "kind": "action",
                    "action": "sql.exec",
                    "input": {
                      "statements": "{{ b }}"
                    }
                  }
                ],
                "max": 200
              },
              {
                "id": "sets",
                "kind": "foreach",
                "items": "{{ steps.find.sets }}",
                "as": "p",
                "nodes": [
                  {
                    "id": "setp",
                    "kind": "action",
                    "action": "pref.set",
                    "input": {
                      "plugin": "news-ext",
                      "key": "{{ p.key }}",
                      "value": "{{ p.value }}"
                    }
                  }
                ],
                "max": 10
              }
            ],
            "catch": []
          },
          {
            "id": "round",
            "kind": "action",
            "action": "lambda.invoke",
            "input": {
              "name": "news.round",
              "event": {
                "all": "{{ input.all }}",
                "onlyIds": "{{ input.onlyIds }}"
              }
            }
          },
          {
            "id": "keep",
            "kind": "foreach",
            "items": "{{ steps.round.batches }}",
            "as": "b",
            "nodes": [
              {
                "id": "keepw",
                "kind": "action",
                "action": "sql.exec",
                "input": {
                  "statements": "{{ b }}"
                }
              }
            ],
            "max": 200
          },
          {
            "id": "scored",
            "kind": "action",
            "action": "lambda.invoke",
            "input": {
              "name": "news.rescore",
              "event": {}
            }
          },
          {
            "id": "scores",
            "kind": "foreach",
            "items": "{{ steps.scored.batches }}",
            "as": "b",
            "nodes": [
              {
                "id": "scoresw",
                "kind": "action",
                "action": "sql.exec",
                "input": {
                  "statements": "{{ b }}"
                }
              }
            ],
            "max": 200
          },
          {
            "id": "soft3",
            "kind": "try",
            "nodes": [
              {
                "id": "gate",
                "kind": "action",
                "action": "lambda.invoke",
                "input": {
                  "name": "news.funnel",
                  "event": {
                    "rounds": 3
                  }
                }
              },
              {
                "id": "gated",
                "kind": "action",
                "action": "sql.exec",
                "input": {
                  "statements": "{{ steps.gate.statements }}"
                }
              },
              {
                "id": "keepstats",
                "kind": "if",
                "when": "{{ steps.gate.stats }}",
                "then": [
                  {
                    "id": "stats",
                    "kind": "action",
                    "action": "pref.set",
                    "input": {
                      "plugin": "news-ext",
                      "key": "news:funnel-stats",
                      "value": "{{ steps.gate.stats }}"
                    }
                  }
                ],
                "else": []
              }
            ],
            "catch": []
          },
          {
            "id": "tidy",
            "kind": "action",
            "action": "lambda.invoke",
            "input": {
              "name": "news.act",
              "event": {
                "op": "clean"
              }
            }
          },
          {
            "id": "tidied",
            "kind": "action",
            "action": "sql.exec",
            "input": {
              "statements": "{{ steps.tidy.statements }}"
            }
          },
          {
            "id": "soft2",
            "kind": "try",
            "nodes": [
              {
                "id": "ahead",
                "kind": "action",
                "action": "lambda.invoke",
                "input": {
                  "name": "news.read-ahead",
                  "event": {
                    "limit": 30
                  }
                }
              },
              {
                "id": "aheadw",
                "kind": "action",
                "action": "sql.exec",
                "input": {
                  "statements": "{{ steps.ahead.statements }}"
                }
              }
            ],
            "catch": []
          },
          {
            "id": "soft1",
            "kind": "try",
            "nodes": [
              {
                "id": "tag",
                "kind": "action",
                "action": "lambda.invoke",
                "input": {
                  "name": "news.tags",
                  "event": {
                    "batches": 2
                  }
                }
              },
              {
                "id": "tags",
                "kind": "foreach",
                "items": "{{ steps.tag.batches }}",
                "as": "b",
                "nodes": [
                  {
                    "id": "tagsw",
                    "kind": "action",
                    "action": "sql.exec",
                    "input": {
                      "statements": "{{ b }}"
                    }
                  }
                ],
                "max": 200
              }
            ],
            "catch": []
          },
          {
            "id": "soft0",
            "kind": "try",
            "nodes": [
              {
                "id": "brief",
                "kind": "action",
                "action": "lambda.invoke",
                "input": {
                  "name": "news.digest",
                  "event": {
                    "auto": true
                  }
                }
              },
              {
                "id": "briefed",
                "kind": "if",
                "when": "{{ steps.brief.digest }}",
                "then": [
                  {
                    "id": "keepbrief",
                    "kind": "action",
                    "action": "pref.set",
                    "input": {
                      "plugin": "news-ext",
                      "key": "news:digest",
                      "value": "{{ steps.brief.digest }}"
                    }
                  }
                ],
                "else": []
              }
            ],
            "catch": []
          },
          {
            "id": "done",
            "kind": "return",
            "value": {
              "ok": "{{ steps.round.ok }}",
              "message": "{{ steps.round.message }}",
              "added": "{{ steps.round.added }}"
            }
          }
        ],
        "requested": {
          "write": "all",
          "ai": true,
          "store": [
            "news-ext.sources",
            "news-ext.items",
            "news-ext.gone",
            "news-ext.terms",
            "news-ext.similar"
          ],
          "web": [
            "*"
          ]
        },
        "sync": {
          "label": "News",
          "what": "Your news fetched, scored for you and filtered — the feeds due, what is new, the agent, the clearing away, reading ahead, the tags, the overview",
          "replaces": "news"
        },
        "triggers": [
          {
            "kind": "manual"
          },
          {
            "kind": "schedule",
            "everyMinutes": 60
          }
        ]
      }
    }
  ]
}
