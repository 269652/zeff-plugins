{
  "$schema": "http://127.0.0.1:9333/ext/sdk/zeff-plugin.schema.json",
  "id": "documents-ext",
  "name": "Documents",
  "version": "0.2.0",
  "description": "Your documents: the text read out of text files, Office files, PDFs, pictures and recordings, the AI's todos from them, which documents belong to which todo, your local folders read in by themselves. Its steps are lambdas and flows you or the AI can change.",
  "author": "Zeff",
  "keywords": ["documents", "pdf", "office", "files", "ocr", "text"],
  "category": "app",
  "icon": "📄",
  "apiVersion": 1,
  "permissions": [],
  "contributes": {
    "lambdas": "lambdas",
    "workspacePackages": [
      "documents.package.json"
    ],
    "appViews": [
      {
        "id": "documents-ext",
        "dataType": "documents",
        "label": "Documents",
        "icon": "🗂",
        "template": "views/documents.html"
      }
    ],
    "sources": [
      {
        "id": "documents",
        "label": "Documents",
        "icon": "📄",
        "hint": "The documents you dropped in or mail attachments brought — with their abstract, where they came from and whether you have seen them (Unread).",
        "lambda": "documents.source",
        "replaces": "documents",
        "noNewRows": false,
        "pull": "documents.pull"
      }
    ],
    "knowledgeDocs": [
      {
        "id": "documents",
        "lambda": "documents.knowledge-docs",
        "args": {},
        "everyMinutes": 30
      }
    ],
    "stores": [
      {
        "name": "documents",
        "adopts": "documents",
        "key": "id",
        "columns": [
          {
            "name": "id",
            "type": "integer"
          },
          {
            "name": "name",
            "type": "text"
          },
          {
            "name": "mime",
            "type": "text"
          },
          {
            "name": "size",
            "type": "integer"
          },
          {
            "name": "sha256",
            "type": "text"
          },
          {
            "name": "kind",
            "type": "text"
          },
          {
            "name": "status",
            "type": "text"
          },
          {
            "name": "error",
            "type": "text"
          },
          {
            "name": "file",
            "type": "text"
          },
          {
            "name": "text",
            "type": "text"
          },
          {
            "name": "summary",
            "type": "text"
          },
          {
            "name": "concepts",
            "type": "text"
          },
          {
            "name": "compiled",
            "type": "integer"
          },
          {
            "name": "created_at",
            "type": "text"
          },
          {
            "name": "updated_at",
            "type": "text"
          }
        ]
      },
      {
        "name": "gate",
        "adopts": "doc_gate",
        "key": "doc_id",
        "columns": [
          {
            "name": "doc_id",
            "type": "integer"
          },
          {
            "name": "state",
            "type": "text"
          },
          {
            "name": "at",
            "type": "text"
          }
        ]
      },
      {
        "name": "seen",
        "adopts": "document_seen",
        "key": "doc_id",
        "columns": [
          {
            "name": "doc_id",
            "type": "integer"
          },
          {
            "name": "at",
            "type": "text"
          }
        ]
      },
      {
        "name": "local_files",
        "adopts": "doc_local_files",
        "key": "path",
        "columns": [
          {
            "name": "path",
            "type": "text"
          },
          {
            "name": "folder_id",
            "type": "text"
          },
          {
            "name": "rel",
            "type": "text"
          },
          {
            "name": "doc_id",
            "type": "integer"
          },
          {
            "name": "size",
            "type": "integer"
          },
          {
            "name": "mtime",
            "type": "integer"
          },
          {
            "name": "missing_at",
            "type": "text"
          }
        ]
      }
    ],
    "aiTasks": [
      {
        "id": "doc-todos",
        "label": "Document review",
        "what": "Finds what you have to do in new and changed documents (Documents plugin)."
      },
      {
        "id": "doc-relations",
        "label": "Document matching",
        "what": "Matches each todo with the documents it is about."
      }
    ]
  }
}
