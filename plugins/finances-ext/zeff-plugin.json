{
  "$schema": "http://127.0.0.1:9333/ext/sdk/zeff-plugin.schema.json",
  "id": "finances-ext",
  "name": "Finances",
  "version": "0.1.0",
  "description": "Your debts and what you are owed: the Kennzahlen of the debts database — what you owe, what you are owed, the instalments a month, months until debt-free. Slice 1 of the port: the rest of Finances (income, spending, formulas, widgets, the overviews) is still the built-in's.",
  "author": "Zeff",
  "keywords": ["finances", "debts", "budget", "instalments", "money", "metrics"],
  "category": "finance",
  "icon": "💶",
  "apiVersion": 1,
  "permissions": [],
  "contributes": {
    "lambdas": "lambdas",
    "stores": [
      {
        "name": "cases",
        "adopts": "cases",
        "key": "id",
        "columns": [
          {
            "name": "id",
            "type": "integer"
          },
          {
            "name": "key",
            "type": "text"
          },
          {
            "name": "label",
            "type": "text"
          },
          {
            "name": "status",
            "type": "text"
          },
          {
            "name": "person_id",
            "type": "integer"
          },
          {
            "name": "note",
            "type": "text"
          },
          {
            "name": "compiled",
            "type": "text"
          },
          {
            "name": "overrides",
            "type": "text"
          },
          {
            "name": "created_at",
            "type": "text"
          },
          {
            "name": "updated_at",
            "type": "text"
          },
          {
            "name": "last_at",
            "type": "text"
          }
        ]
      },
      {
        "name": "parties",
        "adopts": "case_parties",
        "key": [
          "case_id",
          "role"
        ],
        "columns": [
          {
            "name": "case_id",
            "type": "integer"
          },
          {
            "name": "role",
            "type": "text"
          },
          {
            "name": "person_id",
            "type": "integer"
          },
          {
            "name": "source",
            "type": "text"
          }
        ]
      }
    ],
    "workspacePackages": [
      "finances.package.json"
    ],
    "appViews": [
      {
        "id": "overview",
        "dataType": "debts",
        "label": "Debts and claims",
        "icon": "💶",
        "template": "views/debts.html"
      }
    ],
    "knowledgeDocs": [
      {
        "id": "bank",
        "lambda": "finances.bank-docs",
        "args": {},
        "everyMinutes": 30,
        "replaces": "finances"
      }
    ],
    "personFormulas": [
      {
        "name": "Schulden",
        "aliases": [
          "Debts",
          "Deudas"
        ],
        "unit": "€",
        "what": "What you owe them, still open — a circle: one number per person; empty: all you owe",
        "lambda": "finances.formula",
        "args": {
          "which": "owe-open"
        },
        "everyMinutes": 5
      },
      {
        "name": "Forderungen",
        "aliases": [
          "Claims",
          "Owed"
        ],
        "unit": "€",
        "what": "What they owe you, still open — a circle: one number per person; empty: all you are owed",
        "lambda": "finances.formula",
        "args": {
          "which": "owed-open"
        },
        "everyMinutes": 5
      },
      {
        "name": "Rate",
        "aliases": [
          "Instalment",
          "Installment"
        ],
        "unit": "€/Monat",
        "what": "What you pay them a month (the plans running now)",
        "lambda": "finances.formula",
        "args": {
          "which": "owe-rate"
        },
        "everyMinutes": 5
      }
    ],
    "sources": [
      {
        "id": "debts",
        "label": "Debts",
        "icon": "💶",
        "hint": "The cases with money open as debts — creditor, who collects it, total, open, instalment, due day. Rows of your own go beside them.",
        "lambda": "finances.debts",
        "replaces": "debts",
        "noNewRows": false,
        "lockedFields": [
          "debtdir",
          "debtcreditor",
          "debtcollector",
          "debttotal",
          "debtopen",
          "debtrate",
          "debtdue",
          "debtday",
          "debtcase",
          "debtnext",
          "debtclaim"
        ]
      },
      {
        "id": "recurring",
        "label": "Recurring payments",
        "icon": "🔁",
        "hint": "What goes out regularly to the same recipient — contracts and subscriptions read off your bank statements.",
        "lambda": "finances.recurring",
        "replaces": "recurring",
        "noNewRows": true,
        "lockedFields": [
          "ctrmonthly",
          "ctramount",
          "ctrrhythm",
          "ctrlast",
          "ctrnext"
        ]
      }
    ],
    "widgets": [
      {
        "id": "figures",
        "label": "Debts in figures",
        "icon": "💶",
        "description": "What is open, the instalments a month, when you are debt-free and what is left of your income — or the same for what you are owed.",
        "size": "full",
        "ttl": 60,
        "replaces": "finances.figures",
        "lambda": "finances.widget-figures",
        "settings": [
          {
            "key": "dir",
            "label": "Whose",
            "kind": "select",
            "default": "owe",
            "options": [
              {
                "value": "owe",
                "label": "What I owe"
              },
              {
                "value": "owed",
                "label": "What I am owed"
              }
            ]
          },
          {
            "key": "names",
            "label": "Which metrics (names, commas; empty: usual)",
            "kind": "text",
            "default": ""
          }
        ]
      },
      {
        "id": "subscriptions",
        "label": "Subscriptions not in your contracts",
        "icon": "🔁",
        "description": "What goes out regularly but isn't in your contracts database: each with its cost a month and next payment, one click adds it.",
        "size": "half",
        "ttl": 300,
        "replaces": "finances.subscriptions",
        "lambda": "finances.widget-subscriptions",
        "actFlow": "finances.add-subscription",
        "settings": [
          {
            "key": "limit",
            "label": "How many",
            "kind": "number",
            "default": 8,
            "min": 1,
            "max": 30
          }
        ]
      },
      {
        "id": "payments",
        "label": "Payments coming up",
        "icon": "📆",
        "description": "The instalments and payments of your debts (or what comes back to you) in the next weeks — the overdue first, each leading to its debt.",
        "size": "half",
        "ttl": 60,
        "replaces": "finances.payments",
        "lambda": "finances.widget-payments",
        "settings": [
          {
            "key": "dir",
            "label": "Whose",
            "kind": "select",
            "default": "owe",
            "options": [
              {
                "value": "owe",
                "label": "What I owe"
              },
              {
                "value": "owed",
                "label": "What I am owed"
              }
            ]
          },
          {
            "key": "days",
            "label": "Days ahead",
            "kind": "number",
            "default": 45,
            "min": 1,
            "max": 365
          },
          {
            "key": "limit",
            "label": "How many",
            "kind": "number",
            "default": 8,
            "min": 1,
            "max": 30
          }
        ]
      },
      {
        "id": "cashflow",
        "label": "Cashflow ahead",
        "icon": "📈",
        "description": "Your account in the next weeks: income, fixed costs, subscriptions, instalments and payments ahead — the balance week by week and the first day it drops below zero (or your buffer).",
        "size": "full",
        "ttl": 300,
        "replaces": "finances.cashflow",
        "lambda": "finances.widget-cashflow",
        "settings": [
          {
            "key": "balance",
            "label": "Balance today (empty: only the net a month)",
            "kind": "text",
            "default": ""
          },
          {
            "key": "buffer",
            "label": "Buffer (warn below)",
            "kind": "number",
            "default": 0,
            "min": 0,
            "max": 100000
          },
          {
            "key": "days",
            "label": "Days ahead",
            "kind": "number",
            "default": 90,
            "min": 14,
            "max": 180
          }
        ]
      }
    ],
    "metrics": [
      {
        "id": "owe-open",
        "label": "Schuldenstand",
        "unit": "€",
        "what": "What you owe in all, still open",
        "lambda": "finances.metric",
        "args": {
          "which": "owe-open"
        },
        "replaces": "finances",
        "everyMinutes": 15
      },
      {
        "id": "owe-count",
        "label": "Offene Schulden",
        "unit": "",
        "what": "How many debts are still open",
        "lambda": "finances.metric",
        "args": {
          "which": "owe-count"
        },
        "replaces": "finances",
        "everyMinutes": 15
      },
      {
        "id": "rates",
        "label": "Tilgungsrate",
        "unit": "€/Monat",
        "what": "The instalments you pay a month (the plans running now)",
        "lambda": "finances.metric",
        "args": {
          "which": "rates"
        },
        "replaces": "finances",
        "everyMinutes": 15
      },
      {
        "id": "free-in",
        "label": "Schuldenfrei in",
        "unit": "Monate",
        "what": "Months until the last debt with a plan is paid off",
        "lambda": "finances.metric",
        "args": {
          "which": "free-in"
        },
        "replaces": "finances",
        "everyMinutes": 15
      },
      {
        "id": "owe-unplanned",
        "label": "Schulden ohne Plan",
        "unit": "€",
        "what": "What you owe without a payment plan",
        "lambda": "finances.metric",
        "args": {
          "which": "owe-unplanned"
        },
        "replaces": "finances",
        "everyMinutes": 15
      },
      {
        "id": "owed-open",
        "label": "Forderungen",
        "unit": "€",
        "what": "What others owe you, still open",
        "lambda": "finances.metric",
        "args": {
          "which": "owed-open"
        },
        "replaces": "finances",
        "everyMinutes": 15
      },
      {
        "id": "owed-count",
        "label": "Offene Forderungen",
        "unit": "",
        "what": "How many debts others have with you, still open",
        "lambda": "finances.metric",
        "args": {
          "which": "owed-count"
        },
        "replaces": "finances",
        "everyMinutes": 15
      },
      {
        "id": "owed-rates",
        "label": "Rückzahlungen",
        "unit": "€/Monat",
        "what": "What comes back to you a month",
        "lambda": "finances.metric",
        "args": {
          "which": "owed-rates"
        },
        "replaces": "finances",
        "everyMinutes": 15
      },
      {
        "id": "owed-free-in",
        "label": "Alles zurück in",
        "unit": "Monate",
        "what": "Months until the last debt to you with a plan is paid back",
        "lambda": "finances.metric",
        "args": {
          "which": "owed-free-in"
        },
        "replaces": "finances",
        "everyMinutes": 15
      },
      {
        "id": "owed-unplanned",
        "label": "Forderungen ohne Plan",
        "unit": "€",
        "what": "What you are owed without a payment plan",
        "lambda": "finances.metric",
        "args": {
          "which": "owed-unplanned"
        },
        "replaces": "finances",
        "everyMinutes": 15
      },
      {
        "id": "income",
        "label": "Nettoeinkommen",
        "unit": "€/Monat",
        "what": "Your net income a month (set by hand, or read off your statements)",
        "lambda": "finances.metric",
        "args": {
          "which": "income"
        },
        "replaces": "finances",
        "everyMinutes": 15
      },
      {
        "id": "spending",
        "label": "Ausgaben",
        "unit": "€/Monat",
        "what": "What was spent a month — the last three whole months of your bank statements, on average",
        "lambda": "finances.metric",
        "args": {
          "which": "spending"
        },
        "replaces": "finances",
        "everyMinutes": 15
      },
      {
        "id": "credit",
        "label": "Auf Kreditkonten",
        "unit": "€/Monat",
        "what": "What went to the accounts you marked as credit accounts a month",
        "lambda": "finances.metric",
        "args": {
          "which": "credit"
        },
        "replaces": "finances",
        "everyMinutes": 15
      },
      {
        "id": "free-monthly",
        "label": "Frei im Monat",
        "unit": "€/Monat",
        "what": "What is left of your income after the instalments and the fixed costs",
        "lambda": "finances.metric",
        "args": {
          "which": "free-monthly"
        },
        "replaces": "finances",
        "everyMinutes": 15
      },
      {
        "id": "savings-rate",
        "label": "Sparquote",
        "unit": "%",
        "what": "Of your income, the part that didn't go out",
        "lambda": "finances.metric",
        "args": {
          "which": "savings-rate"
        },
        "replaces": "finances",
        "everyMinutes": 15
      },
      {
        "id": "debt-service-rate",
        "label": "Schuldendienstquote",
        "unit": "%",
        "what": "Of your income, the part the instalments take",
        "lambda": "finances.metric",
        "args": {
          "which": "debt-service-rate"
        },
        "replaces": "finances",
        "everyMinutes": 15
      }
    ]
  }
}
