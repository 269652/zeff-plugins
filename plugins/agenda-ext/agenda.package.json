            "app": "template",
            "template": "<data name=\"agenda\" lambda=\"agenda.data\" with='{\"db\": {{ db.id }}, \"done\": \"Done\"}'/>\n<state name=\"v\" value=\"2\"/><state name=\"p\" value=\"\"/><state name=\"scope\" value=\"all\"/><state name=\"q\" value=\"\"/><state name=\"adding\" value=\"\"/><state name=\"tag\" value=\"\"/><state name=\"who\" value=\"\"/><state name=\"showdone\" value=\"\"/>\n<state name=\"nt\" value=\"\"/>\n<state name=\"ndated\" value=\"true\"/>\n<state name=\"ns\" value=\"\"/>\n<state name=\"ne\" value=\"\"/>\n<state name=\"np\" value=\"\"/>\n<state name=\"nag\" value=\"\"/>\n<state name=\"npin\" value=\"\"/>\n<state name=\"ntags\" value=\"\"/>\n<state name=\"nrem\" value=\"\"/>\n<state name=\"ntext\" value=\"\"/>\n<dialog bind=\"adding\" title=\"New note\">\n<input bind=\"nt\" label=\"Title\" placeholder=\"What is it about?\"/>\n<toggle bind=\"ndated\" label=\"Has a date\"/>\n{{#if state.ndated}}<row gap=2><input bind=\"ns\" type=\"date\" label=\"Date\"/><input bind=\"ne\" type=\"date\" label=\"Until (a range)\"/></row>{{/if}}\n{{#if data.agenda.projectOptions}}<select bind=\"np\" options=\"{{ data.agenda.projectOptions }}\" label=\"Project\"/>{{/if}}\n<row gap=3><toggle bind=\"nag\" label=\"On the agenda\"/><toggle bind=\"npin\" label=\"📌 Pinned\"/></row>\n<input bind=\"ntags\" label=\"Tags\" placeholder=\"comma separated — a new one is made\"/>\n<input bind=\"nrem\" type=\"date\" label=\"Reminder\"/>\n<input bind=\"ntext\" type=\"textarea\" label=\"Text\"/>\n<button run=\"agenda.add-note\" with='{\"database\": {{ db.id }}, \"title\": {{ state.nt | tojson }}, \"dated\": {{ state.ndated | tojson }}, \"start\": {{ state.ns | tojson }}, \"end\": {{ state.ne | tojson }}, \"project\": {{ state.np | tojson }}, \"agenda\": {{ state.nag | tojson }}, \"pinned\": {{ state.npin | tojson }}, \"tags\": {{ state.ntags | tojson }}, \"reminder\": {{ state.nrem | tojson }}, \"text\": {{ state.ntext | tojson }}, \"names\": {\"date\":\"Date\",\"project\":\"Project\",\"agenda\":\"On the agenda\",\"pinned\":\"Pinned\",\"tags\":\"Tags\",\"reminder\":\"Reminder\"}}' emit=\"agenda-note-saved\" done=\"Saved.\" label=\"Save\" variant=primary disabled=\"{{ state.nt ? 'false' : 'true' }}\"/>\n</dialog>\n<on event=\"agenda-note-saved\" action=\"state\" state=\"nt\" value=\"\"/><on event=\"agenda-note-saved\" action=\"state\" state=\"ne\" value=\"\"/><on event=\"agenda-note-saved\" action=\"state\" state=\"ntags\" value=\"\"/><on event=\"agenda-note-saved\" action=\"state\" state=\"nrem\" value=\"\"/><on event=\"agenda-note-saved\" action=\"state\" state=\"ntext\" value=\"\"/><on event=\"agenda-note-saved\" action=\"state\" state=\"nag\" value=\"\"/><on event=\"agenda-note-saved\" action=\"state\" state=\"npin\" value=\"\"/><on event=\"agenda-note-saved\" action=\"state\" state=\"adding\" value=\"\"/>\n<nav title=\"Agenda\">\n<entry label=\"All notes\" icon=\"📒\" state=\"scope\" value=\"all\" n=\"{{ rows | where('Done', '!=', true) | count }}\" group=\"Overview\"/>\n<entry label=\"On the agenda\" icon=\"●\" state=\"scope\" value=\"agenda\" n=\"{{ rows | where('On the agenda', true) | where('Done', '!=', true) | count }}\" group=\"Overview\"/>\n<entry label=\"Today\" icon=\"📅\" state=\"scope\" value=\"today\" n=\"{{ rows | where('Date', now) | count }}\" group=\"Overview\"/>\n<entry label=\"Coming up\" icon=\"⏭\" state=\"scope\" value=\"upcoming\" n=\"{{ rows | where('Date', '>=', now) | where('Done', '!=', true) | count }}\" group=\"Overview\"/>\n<entry label=\"Reminders\" icon=\"⏰\" state=\"scope\" value=\"reminders\" n=\"{{ rows | where('Reminder', 'filled') | where('Done', '!=', true) | count }}\" group=\"Overview\"/>\n<entry label=\"Done\" icon=\"✓\" state=\"scope\" value=\"done\" n=\"{{ rows | where('Done', true) | count }}\" group=\"Overview\"/>\n<entry label=\"All projects\" icon=\"🗂️\" state=\"p\" value=\"\" group=\"Projects\"/>\n{{#each data.agenda.projects}}<entry label=\"{{ title }}\" icon=\"{{ icon }}\" state=\"p\" value=\"{{ title }}\" n=\"{{ open }}\" group=\"{{ category }}\"/>{{/each}}\n</nav>\n<panes>\n<pane title=\"{{ state.p ? state.p : 'Notes' }}\" aside=\"{{ rows | search(state.q) | only('Project', state.p) | only('Tags', state.tag) | only('People', state.who) | where('Done', '!=', true) | count }}\">\n<toolbar><button action=\"state\" state=\"adding\" value=\"true\" label=\"New note\" variant=primary/><search bind=\"q\" placeholder=\"Search notes\"/><toggle bind=\"showdone\" label=\"Show done ones\"/></toolbar>\n{{#if rows | where('Tags', 'filled') | count}}<facets bind=\"tag\" field=\"Tags\" source=\"rows | where('Done', '!=', true)\" all=\"All tags\"/>{{/if}}\n{{#if rows | where('People', 'filled') | count}}<facets bind=\"who\" field=\"People\" source=\"rows | where('Done', '!=', true)\" all=\"Everyone\"/>{{/if}}\n<quickadd placeholder=\"New note …\"/>\n{{#if state.scope == 'all'}}{{#if state.showdone}}<timeline source=\"rows | search(state.q) | only('Project', state.p) | only('Tags', state.tag) | only('People', state.who) | limit(100000) | sort('Date', 'desc') | sort('Pinned', 'desc')\" date=\"{{ [Date] | date }}\" page=30 more=\"Show more\" empty=\"No notes yet: write the first one above.\">\n<row wrap=false gap=2 align=center><col fill=true>{{#if [Done]}}<strike>{{ title | default('…') }}</strike>{{#else}}<b>{{ title | default('…') }}</b>{{/if}}</col><todomark/>{{#if [Pinned]}}<small>📌</small>{{/if}}{{ [Project] | chip }}</row>\n{{#if [Tags]}}<row gap=1>{{ [Tags] | chip }}{{ [People] | chip }}</row>{{/if}}\n{{#if [Reminder]}}<small><muted>⏰ {{ [Reminder] | date }}</muted></small>{{/if}}\n{{#if text}}<text pre=true><clamp lines=8>{{ text }}</clamp></text>{{/if}}\n<row gap=1><button action=\"toggle\" prop=\"On the agenda\" label=\"{{ [On the agenda] ? '● On the agenda' : '○ On the agenda' }}\" variant=quiet/><button action=\"toggle\" prop=\"Done\" label=\"{{ [Done] ? '✓ Done' : '○ Done' }}\" variant=quiet/><button action=\"toggle\" prop=\"Pinned\" label=\"📌\" tip=\"Pin to the top\" variant=quiet/><button action=\"open\" label=\"Open\" variant=quiet/></row>\n</timeline>{{#else}}<timeline source=\"rows | search(state.q) | only('Project', state.p) | only('Tags', state.tag) | only('People', state.who) | where('Done', '!=', true) | sort('Date', 'desc') | sort('Pinned', 'desc')\" date=\"{{ [Date] | date }}\" page=30 more=\"Show more\" empty=\"No notes yet: write the first one above.\">\n<row wrap=false gap=2 align=center><col fill=true>{{#if [Done]}}<strike>{{ title | default('…') }}</strike>{{#else}}<b>{{ title | default('…') }}</b>{{/if}}</col><todomark/>{{#if [Pinned]}}<small>📌</small>{{/if}}{{ [Project] | chip }}</row>\n{{#if [Tags]}}<row gap=1>{{ [Tags] | chip }}{{ [People] | chip }}</row>{{/if}}\n{{#if [Reminder]}}<small><muted>⏰ {{ [Reminder] | date }}</muted></small>{{/if}}\n{{#if text}}<text pre=true><clamp lines=8>{{ text }}</clamp></text>{{/if}}\n<row gap=1><button action=\"toggle\" prop=\"On the agenda\" label=\"{{ [On the agenda] ? '● On the agenda' : '○ On the agenda' }}\" variant=quiet/><button action=\"toggle\" prop=\"Done\" label=\"{{ [Done] ? '✓ Done' : '○ Done' }}\" variant=quiet/><button action=\"toggle\" prop=\"Pinned\" label=\"📌\" tip=\"Pin to the top\" variant=quiet/><button action=\"open\" label=\"Open\" variant=quiet/></row>\n</timeline>{{/if}}{{/if}}\n{{#if state.scope == 'agenda'}}<timeline source=\"rows | search(state.q) | only('Project', state.p) | only('Tags', state.tag) | only('People', state.who) | where('On the agenda', true) | where('Done', '!=', true) | sort('Date', 'desc') | sort('Pinned', 'desc')\" date=\"{{ [Date] | date }}\" page=30 more=\"Show more\" empty=\"Nothing on the agenda: put a note there with ○ On the agenda.\">\n<row wrap=false gap=2 align=center><col fill=true>{{#if [Done]}}<strike>{{ title | default('…') }}</strike>{{#else}}<b>{{ title | default('…') }}</b>{{/if}}</col><todomark/>{{#if [Pinned]}}<small>📌</small>{{/if}}{{ [Project] | chip }}</row>\n{{#if [Tags]}}<row gap=1>{{ [Tags] | chip }}{{ [People] | chip }}</row>{{/if}}\n{{#if [Reminder]}}<small><muted>⏰ {{ [Reminder] | date }}</muted></small>{{/if}}\n{{#if text}}<text pre=true><clamp lines=8>{{ text }}</clamp></text>{{/if}}\n<row gap=1><button action=\"toggle\" prop=\"On the agenda\" label=\"{{ [On the agenda] ? '● On the agenda' : '○ On the agenda' }}\" variant=quiet/><button action=\"toggle\" prop=\"Done\" label=\"{{ [Done] ? '✓ Done' : '○ Done' }}\" variant=quiet/><button action=\"toggle\" prop=\"Pinned\" label=\"📌\" tip=\"Pin to the top\" variant=quiet/><button action=\"open\" label=\"Open\" variant=quiet/></row>\n</timeline>{{/if}}\n{{#if state.scope == 'today'}}<timeline source=\"rows | search(state.q) | only('Project', state.p) | only('Tags', state.tag) | only('People', state.who) | where('Date', now) | sort('Date', 'desc') | sort('Pinned', 'desc')\" date=\"{{ [Date] | date }}\" page=30 more=\"Show more\" empty=\"No note for today.\">\n<row wrap=false gap=2 align=center><col fill=true>{{#if [Done]}}<strike>{{ title | default('…') }}</strike>{{#else}}<b>{{ title | default('…') }}</b>{{/if}}</col><todomark/>{{#if [Pinned]}}<small>📌</small>{{/if}}{{ [Project] | chip }}</row>\n{{#if [Tags]}}<row gap=1>{{ [Tags] | chip }}{{ [People] | chip }}</row>{{/if}}\n{{#if [Reminder]}}<small><muted>⏰ {{ [Reminder] | date }}</muted></small>{{/if}}\n{{#if text}}<text pre=true><clamp lines=8>{{ text }}</clamp></text>{{/if}}\n<row gap=1><button action=\"toggle\" prop=\"On the agenda\" label=\"{{ [On the agenda] ? '● On the agenda' : '○ On the agenda' }}\" variant=quiet/><button action=\"toggle\" prop=\"Done\" label=\"{{ [Done] ? '✓ Done' : '○ Done' }}\" variant=quiet/><button action=\"toggle\" prop=\"Pinned\" label=\"📌\" tip=\"Pin to the top\" variant=quiet/><button action=\"open\" label=\"Open\" variant=quiet/></row>\n</timeline>{{/if}}\n{{#if state.scope == 'upcoming'}}<timeline source=\"rows | search(state.q) | only('Project', state.p) | only('Tags', state.tag) | only('People', state.who) | where('Date', '>='