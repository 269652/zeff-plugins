{
  "format": 1,
  "id": "news-ext",
  "version": "1.0.0",
  "name": "News",
  "description": "Your news, gathered for you: the feeds you pick, everything scored for you.",
  "icon": "📰",
  "items": [
    {
      "id": "i1",
      "kind": "page",
      "title": "News",
      "icon": "📰",
      "content": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph"
          }
        ]
      }
    },
    {
      "id": "i4",
      "parent": "i1",
      "kind": "page",
      "title": "Let the agent look",
      "icon": "📰",
      "content": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph"
          }
        ]
      },
      "flow": {
        "name": "news.funnel",
        "title": "Let the agent look at the news",
        "description": "The best new items go to an agent that lets through what interests you, marks what is important and filters out the rest — rounds (3 with the sync, up to 10 by hand).",
        "inputs": [],
        "nodes": [
          {
            "id": "gate",
            "kind": "action",
            "action": "lambda.invoke",
            "input": {
              "name": "news.funnel",
              "event": {
                "rounds": "{{ input.rounds }}"
              }
            }
          },
          {
            "id": "gated",
            "kind": "action",
            "action": "sql.exec",
            "input": {
              "statements": "{{ steps.gate.statements }}"
            }
          },
          {
            "id": "keepstats",
            "kind": "if",
            "when": "{{ steps.gate.stats }}",
            "then": [
              {
                "id": "stats",
                "kind": "action",
                "action": "pref.set",
                "input": {
                  "plugin": "news-ext",
                  "key": "news:funnel-stats",
                  "value": "{{ steps.gate.stats }}"
                }
              }
            ],
            "else": []
          },
          {
            "id": "done",
            "kind": "return",
            "value": {
              "judged": "{{ steps.gate.judged }}",
              "passed": "{{ steps.gate.passed }}",
              "top": "{{ steps.gate.top }}",
              "dropped": "{{ steps.gate.dropped }}"
            }
          }
        ],
        "requested": {
          "write": "all",
          "ai": true,
          "store": [
            "news-ext.sources",
            "news-ext.items",
            "news-ext.gone",
            "news-ext.terms",
            "news-ext.similar"
          ]
        },
        "triggers": [
          {
            "kind": "manual"
          }
        ]
      }
    },
    {
      "id": "i5",
      "parent": "i1",
      "kind": "page",
      "title": "The overview",
      "icon": "📰",
      "content": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph"
          }
        ]
      },
      "flow": {
        "name": "news.digest",
        "title": "The overview of the day",
        "description": "The AI's briefing of the best unread items: what matters, the themes, the few to read first.",
        "inputs": [],
        "nodes": [
          {
            "id": "brief",
            "kind": "action",
            "action": "lambda.invoke",
            "input": {
              "name": "news.digest",
              "event": {}
            }
          },
          {
            "id": "briefed",
            "kind": "if",
            "when": "{{ steps.brief.digest }}",
            "then": [
              {
                "id": "keepbrief",
                "kind": "action",
                "action": "pref.set",
                "input": {
                  "plugin": "news-ext",
                  "key": "news:digest",
                  "value": "{{ steps.brief.digest }}"
                }
              }
            ],
            "else": []
          },
          {
            "id": "done",
            "kind": "return",
            "value": {
              "digest": "{{ steps.brief.digest }}"
            }
          }
        ],
        "requested": {
          "write": "all",
          "ai": true,
          "store": [
            "news-ext.sources",
            "news-ext.items",
            "news-ext.gone",
            "news-ext.terms",
            "news-ext.similar"
          ]
        },
        "triggers": [
          {
            "kind": "manual"
          }
        ]
      }
    },
    {
      "id": "i11",
      "parent": "i1",
      "kind": "page",
      "title": "Change a news setting",
      "icon": "⚙️",
      "content": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph"
          }
        ]
      },
      "flow": {
        "name": "news.pref",
        "title": "Change a news setting",
        "description": "One setting of News changed (input key, value): interests, mutes, language, the switches and the numbers — everything is scored again for you. Run by the settings page.",
        "inputs": [],
        "nodes": [
          {
            "id": "set",
            "kind": "action",
            "action": "lambda.invoke",
            "input": {
              "name": "news.settings",
              "event": {
                "key": "{{ input.key }}",
                "value": "{{ input.value }}"
              }
            }
          },
          {
            "id": "ok",
            "kind": "if",
            "when": "{{ steps.set.prefs }}",
            "then": [
              {
                "id": "keep",
                "kind": "action",
                "action": "pref.set",
                "input": {
                  "plugin": "news-ext",
                  "key": "news:prefs",
                  "value": "{{ steps.set.prefs }}"
                }
              },
              {
                "id": "rs",
                "kind": "action",
                "action": "lambda.invoke",
                "input": {
                  "name": "news.rescore",
                  "event": {}
                }
              },
              {
                "id": "rsw",
                "kind": "foreach",
                "items": "{{ steps.rs.batches }}",
                "as": "b",
                "nodes": [
                  {
                    "id": "rsx",
                    "kind": "action",
                    "action": "sql.exec",
                    "input": {
                      "statements": "{{ b }}"
                    }
                  }
                ],
                "max": 200
              }
            ],
            "else": []
          },
          {
            "id": "done",
            "kind": "return",
            "value": {
              "error": "{{ steps.set.error }}"
            }
          }
        ],
        "requested": {
          "write": "all",
          "store": [
            "news-ext.sources",
            "news-ext.items",
            "news-ext.gone",
            "news-ext.terms",
            "news-ext.similar"
          ]
        },
        "triggers": [
          {
            "kind": "manual"
          }
        ]
      }
    },
    {
      "id": "i12",
      "parent": "i1",
      "kind": "database",
      "title": "News settings",
      "icon": "⚙️",
      "schema": {
        "titleName": "Settings",
        "properties": [],
        "views": [
          {
            "id": "vnews1",
            "name": "News settings",
            "type": "app",
            "filter": {
              "op": "and",
              "rules": []
            },
            "sorts": [],
            "hidden": [],
            "app": "template",
            "template": "<state name=\"s_interests\" value=\"\"/><state name=\"s_mutes\" value=\"\"/><state name=\"s_url\" value=\"\"/><state name=\"s_name\" value=\"\"/><state name=\"s_taste\" value=\"\"/><state name=\"s_find\" value=\"\"/><state name=\"n_maxAge\" value=\"\"/><state name=\"n_perSource\" value=\"\"/><state name=\"n_perRun\" value=\"\"/><state name=\"n_keepDays\" value=\"\"/><state name=\"n_batch\" value=\"\"/><state name=\"n_keepLatest\" value=\"\"/>\n<data name=\"s\" lambda=\"news.settings\" with=\"mode=data\"/>\n<on event=\"settings-changed\" action=\"reload\"/>\n<text tone=muted>Where your news comes from and what makes it yours. Everything is fetched from public feeds; nothing of yours is sent.</text>\n{{#if not data.s}}<muted>Loading …</muted>{{#else}}\n<box title=\"What suits you\">\n<col gap=3>\n<row gap=2 wrap=false><col fill=true><input bind=\"s_interests\" rows=3 label=\"Interests (one per line or comma; a number 1–3 after × says how much it counts)\" value=\"{{ data.s.prefs.interestsText }}\"/></col><button run=\"news.pref\" with=\"key=interests, value={{ state.s_interests }}\" done=\"Saved.\" emit=\"settings-changed\" label=\"Save\" variant=primary/></row>\n<row gap=2 wrap=false><col fill=true><input bind=\"s_mutes\" rows=2 label=\"Muted words (items with one are left out)\" value=\"{{ data.s.prefs.mutesText }}\"/></col><button run=\"news.pref\" with=\"key=mutes, value={{ state.s_mutes }}\" done=\"Saved.\" emit=\"settings-changed\" label=\"Save\" variant=primary/></row>\n<row gap=2><small><muted>Language of the topic searches</muted></small>\n<button run=\"news.pref\" with=\"key=language, value=de\" emit=\"settings-changed\" label=\"Deutsch\" variant=\"{{ data.s.prefs.language == 'de' ? 'primary' : 'plain' }}\"/>\n<button run=\"news.pref\" with=\"key=language, value=en\" emit=\"settings-changed\" label=\"English\" variant=\"{{ data.s.prefs.language == 'en' ? 'primary' : 'plain' }}\"/>\n<button run=\"news.pref\" with=\"key=language, value=any\" emit=\"settings-changed\" label=\"Both\" variant=\"{{ data.s.prefs.language == 'any' ? 'primary' : 'plain' }}\"/></row>\n<col gap=1>\n{{#each data.s.flags}}\n<row gap=2 align=center wrap=false><button run=\"news.pref\" with=\"key={{ key }}, value={{ on ? 'false' : 'true' }}\" emit=\"settings-changed\" label=\"{{ word }} {{ label }}\" variant=\"{{ on ? 'primary' : 'quiet' }}\"/><small><muted>{{ what }}</muted></small></row>\n{{/each}}\n</col>\n<grid cols=3 gap=2 min=200>\n<row gap=1 wrap=false><input bind=\"n_maxAge\" type=number label=\"Days of news\" value=\"{{ data.s.prefs.maxAgeDays }}\"/><button run=\"news.pref\" with=\"key=maxAgeDays, value={{ state.n_maxAge }}\" emit=\"settings-changed\" label=\"Set\"/></row>\n<row gap=1 wrap=false><input bind=\"n_perSource\" type=number label=\"Most per source\" value=\"{{ data.s.prefs.perSource }}\"/><button run=\"news.pref\" with=\"key=perSource, value={{ state.n_perSource }}\" emit=\"settings-changed\" label=\"Set\"/></row>\n<row gap=1 wrap=false><input bind=\"n_perRun\" type=number label=\"Feeds per round\" value=\"{{ data.s.prefs.perRun }}\"/><button run=\"news.pref\" with=\"key=perRun, value={{ state.n_perRun }}\" emit=\"settings-changed\" label=\"Set\"/></row>\n<row gap=1 wrap=false><input bind=\"n_keepDays\" type=number label=\"Keep read items (days)\" value=\"{{ data.s.prefs.keepDays }}\"/><button run=\"news.pref\" with=\"key=keepDays, value={{ state.n_keepDays }}\" emit=\"settings-changed\" label=\"Set\"/></row>\n<row gap=1 wrap=false><input bind=\"n_batch\" type=number label=\"Agent reads per round\" value=\"{{ data.s.prefs.funnelBatch }}\"/><button run=\"news.pref\" with=\"key=funnelBatch, value={{ state.n_batch }}\" emit=\"settings-changed\" label=\"Set\"/></row>\n<row gap=1 wrap=false><input bind=\"n_keepLatest\" type=number label=\"Newest and best kept\" value=\"{{ data.s.prefs.keepLatest }}\"/><button run=\"news.pref\" with=\"key=keepLatest, value={{ state.n_keepLatest }}\" emit=\"settings-changed\" label=\"Set\"/></row>\n</grid>\n</col>\n</box>\n<box title=\"Sources ({{ data.s.sourceCount }})\">\n<col gap=3>\n<row gap=2 wrap=true>\n<input bind=\"s_url\" label=\"Feed address (https://…)\"/><input bind=\"s_name\" label=\"Name (optional)\"/>\n<button run=\"news.act\" with=\"op=source-add, url={{ state.s_url }}, name={{ state.s_name }}\" done=\"Added.\" emit=\"settings-changed\" label=\"Add\" variant=primary disabled=\"{{ not state.s_url }}\"/>\n</row>\n<row gap=2 wrap=true>\n<button run=\"news.act\" with=\"op=starter\" done=\"Starter pack added.\" emit=\"settings-changed\" label=\"Starter pack ({{ data.s.starter }})\"/>\n{{#each data.s.categories}}{{#if left}}<button run=\"news.act\" with=\"op=category, name={{ category }}\" done=\"Added.\" emit=\"settings-changed\" label=\"+ {{ category }} ({{ left }})\" variant=quiet/>{{/if}}{{/each}}\n</row>\n{{#each data.s.sources}}\n<row gap=2 align=center wrap=false>\n<col fill=true><b>{{ name }}</b><small><muted>{{ category }} · {{ items }} items{{#if lastAt}} · fetched {{ lastAt }}{{/if}}{{#if votes}} · votes {{ votes }}{{/if}}</muted></small>{{#if lastError}}<small><muted>{{ lastError }}</muted></small>{{/if}}</col>\n<button run=\"news.act\" with=\"op=source-update, id={{ id }}, enabled={{ enabled ? 'false' : 'true' }}\" emit=\"settings-changed\" label=\"{{ enabled ? 'On' : 'Off' }}\" variant=\"{{ enabled ? 'primary' : 'plain' }}\"/>\n<button run=\"news.act\" with=\"op=source-remove, id={{ id }}\" confirm=\"Remove this source? Saved items stay.\" emit=\"settings-changed\" label=\"✕\" variant=quiet/>\n</row>\n{{/each}}\n</col>\n</box>\n<box title=\"Find feeds\">\n<col gap=2>\n<row gap=2 wrap=false><col fill=true><input bind=\"s_find\" label=\"A website or a profile on one\"/></col><button run=\"news.find-feeds\" with=\"address={{ state.s_find }}\" into=\"found\" label=\"Find\" disabled=\"{{ not state.s_find }}\"/></row>\n{{#each data.found.feeds}}\n<row gap=2 align=center wrap=false><col fill=true><b>{{ title }}</b><small><muted>{{ url }} · {{ items }} items</muted></small></col><button run=\"news.act\" with=\"op=source-add, url={{ url }}, name={{ title }}, category=Found\" done=\"Added.\" emit=\"settings-changed\" label=\"Add\" variant=primary/></row>\n{{/each}}\n{{#if data.s.discoveries}}<small><muted>Found by itself lately</muted></small>\n{{#each data.s.discoveries}}<small><muted>{{ at }} · {{ topic }} → {{ name }}</muted></small>{{/each}}{{/if}}\n</col>\n</box>\n<box title=\"✨ Your taste\">\n<col gap=2>\n<text tone=muted>{{ data.s.taste.text }}</text>\n<small><muted>{{ data.s.taste.pending }} signals waiting to be taken in</muted></small>\n<input bind=\"s_taste\" rows=4 label=\"Edit it (the AI continues from your version)\" value=\"{{ data.s.taste.text }}\"/>\n<row gap=2>\n<button run=\"news.act\" with=\"op=taste-edit, text={{ state.s_taste }}\" done=\"Saved.\" emit=\"settings-changed\" label=\"Save\" variant=primary/>\n<button run=\"news.taste\" done=\"Updated.\" emit=\"settings-changed\" label=\"Update now\"/>\n<button run=\"news.act\" with=\"op=taste-forget\" confirm=\"Forget your written taste?\" emit=\"settings-changed\" label=\"Forget it\" variant=quiet/>\n<button run=\"news.act\" with=\"op=forget, rescore=true\" confirm=\"Forget what your likes and dislikes taught?\" done=\"Forgotten.\" emit=\"settings-changed\" label=\"Forget what I liked\" variant=quiet/>\n</row>\n</col>\n</box>\n{{/if}}\n"
          }
        ]
      },
      "rows": [
        {
          "id": "r1",
          "title": "News settings",
          "cells": {},
          "content": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "i9",
      "parent": "i1",
      "kind": "page",
      "title": "Discover",
      "icon": "✨",
      "content": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph"
          }
        ]
      },
      "flow": {
        "name": "news.discover",
        "title": "Discover from my taste",
        "description": "Your taste brought up to date, searches planned from it, the web searched, new sources found and added, everything unread matched against your taste — the Discover view.",
        "inputs": [],
        "nodes": [
          {
            "id": "taste",
            "kind": "action",
            "action": "lambda.invoke",
            "input": {
              "name": "news.taste",
              "event": {}
            }
          },
          {
            "id": "keeptaste",
            "kind": "if",
            "when": "{{ steps.taste.taste }}",
            "then": [
              {
                "id": "settaste",
                "kind": "action",
                "action": "pref.set",
                "input": {
                  "plugin": "news-ext",
                  "key": "news:taste",
                  "value": "{{ steps.taste.taste }}"
                }
              }
            ],
            "else": []
          },
          {
            "id": "run",
            "kind": "action",
            "action": "lambda.invoke",
            "input": {
              "name": "news.discover",
              "event": {}
            }
          },
          {
            "id": "write",
            "kind": "foreach",
            "items": "{{ steps.run.batches }}",
            "as": "b",
            "nodes": [
              {
                "id": "writew",
                "kind": "action",
                "action": "sql.exec",
                "input": {
                  "statements": "{{ b }}"
                }
              }
            ],
            "max": 200
          },
          {
            "id": "sets",
            "kind": "foreach",
            "items": "{{ steps.run.sets }}",
            "as": "p",
            "nodes": [
              {
                "id": "setp",
                "kind": "action",
                "action": "pref.set",
                "input": {
                  "plugin": "news-ext",
                  "key": "{{ p.key }}",
                  "value": "{{ p.value }}"
                }
              }
            ],
            "max": 10
          },
          {
            "id": "match",
            "kind": "action",
            "action": "lambda.invoke",
            "input": {
              "name": "news.match",
              "event": {}
            }
          },
          {
            "id": "matched",
            "kind": "foreach",
            "items": "{{ steps.match.batches }}",
            "as": "b",
            "nodes": [
              {
                "id": "matchedw",
                "kind": "action",
                "action": "sql.exec",
                "input": {
                  "statements": "{{ b }}"
                }
              }
            ],
            "max": 200
          },
          {
            "id": "done",
            "kind": "return",
            "value": {
              "ok": "{{ steps.run.ok }}",
              "message": "{{ steps.run.message }}",
              "matched": "{{ steps.match.matched }}"
            }
          }
        ],
        "requested": {
          "write": "all",
          "ai": true,
          "store": [
            "news-ext.sources",
            "news-ext.items",
            "news-ext.gone",
            "news-ext.terms",
            "news-ext.similar"
          ],
          "web": [
            "*"
          ]
        },
        "triggers": [
          {
            "kind": "manual"
          }
        ]
      }
    },
    {
      "id": "i10",
      "parent": "i1",
      "kind": "page",
