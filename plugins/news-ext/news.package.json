      "flow": {
        "name": "news.more-like",
        "title": "More like this",
        "description": "More about what an article is about (input id): the AI's reading, the web searched, the answers ranked and tied to the card, new sources found.",
        "inputs": [],
        "nodes": [
          {
            "id": "run",
            "kind": "action",
            "action": "lambda.invoke",
            "input": {
              "name": "news.more-like",
              "event": {
                "mode": "search",
                "id": "{{ input.id }}"
              }
            }
          },
          {
            "id": "ok",
            "kind": "if",
            "when": "{{ steps.run.ok }}",
            "then": [
              {
                "id": "write",
                "kind": "foreach",
                "items": "{{ steps.run.batches }}",
                "as": "b",
                "nodes": [
                  {
                    "id": "writew",
                    "kind": "action",
                    "action": "sql.exec",
                    "input": {
                      "statements": "{{ b }}"
                    }
                  }
                ],
                "max": 200
              },
              {
                "id": "tie",
                "kind": "action",
                "action": "lambda.invoke",
                "input": {
                  "name": "news.more-like",
