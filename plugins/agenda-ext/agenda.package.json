            "name": "start",
            "type": "text"
          },
          {
            "name": "end",
            "type": "text"
          },
          {
            "name": "project",
            "type": "text"
          },
          {
            "name": "agenda",
            "type": "text"
          },
          {
            "name": "pinned",
            "type": "text"
          },
          {
            "name": "tags",
            "type": "text"
          },
          {
            "name": "reminder",
            "type": "text"
          },
          {
            "name": "text",
            "type": "text"
          },
          {
            "name": "names",
            "type": "json"
          }
        ],
        "nodes": [
          {
            "id": "values",
            "kind": "script",
            "code": "const input = flowInput;\nconst n = input.names || {};\nconst yes = (v) => v === true || v === 'true';\nconst today = env.today;\nconst v = {};\nif (yes(input.dated) && n.date) { const start = input.start || today; v[n.date] = input.end && input.end > start ? { start, end: input.end } : start; }\nif (input.project && n.project) v[n.project] = [input.project];\nif (yes(input.agenda) && n.agenda) v[n.agenda] = true;\nif (yes(input.pinned) && n.pinned) v[n.pinned] = true;\nif (input.reminder && n.reminder) v[n.reminder] = input.reminder;\nconst tags = String(input.tags || '').split(',').map((x) => x.trim()).filter(Boolean);\nif (tags.length && n.tags) v[n.tags] = [...new Set(tags)];\nreturn v;"
          },
          {
            "id": "add",
            "kind": "action",
            "action": "db.add",
            "input": {
              "database": "{{ input.database }}",
              "title": "{{ input.title }}",
              "values": "{{ steps.values }}",
              "markdown": "{{ input.text }}"
            }
          }
        ],
        "output": "{{ steps.add }}",
        "triggers": [
          {
            "kind": "manual"
          }
        ],
        "enabled": true,
        "requested": {
          "write": [
            "@agenda-ext.i3"
          ]
        }
