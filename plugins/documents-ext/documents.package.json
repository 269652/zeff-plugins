    {
      "id": "i14",
      "parent": "i1",
      "kind": "page",
      "title": "Fetch the documents' abstracts",
      "icon": "📄",
      "content": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph"
          }
        ]
      },
      "flow": {
        "name": "documents.abstracts",
        "title": "Fetch the documents' abstracts",
        "description": "The knowledge server is asked to take in and compile what is new; the abstracts and concepts of the documents it compiled are kept with them. Runs by itself every ten minutes.",
        "inputs": [],
        "nodes": [
          {
            "id": "plan",
            "kind": "action",
            "action": "lambda.invoke",
            "input": {
              "name": "documents.abstracts-plan",
              "event": {}
            }
          },
          {
            "id": "ask",
            "kind": "if",
            "when": "{{ steps.plan.ids }}",
            "then": [
              {
                "id": "sync",
                "kind": "action",
                "action": "knowledge.sync",
                "input": {}
              },
              {
                "id": "pages",
                "kind": "action",
                "action": "knowledge.pages",
                "input": {
                  "ids": "{{ steps.plan.ids }}"
                }
              },
              {
                "id": "res",
                "kind": "action",
                "action": "lambda.invoke",
                "input": {
                  "name": "documents.abstracts-result",
                  "event": {
                    "pages": "{{ steps.pages.pages }}"
                  }
                }
              },
              {
                "id": "wrote",
                "kind": "if",
                "when": "{{ steps.res.statements }}",
                "then": [
                  {
                    "id": "write",
                    "kind": "action",
                    "action": "sql.exec",
                    "input": {
                      "statements": "{{ steps.res.statements }}"
                    }
                  }
                ],
                "else": []
              }
            ],
            "else": []
          },
          {
            "id": "done",
            "kind": "return",
            "value": {
              "ok": true,
              "message": "{{ steps.res.n }}"
            }
          }
        ],
        "requested": {
          "store": [
            "documents-ext.documents",
            "documents-ext.gate",
            "documents-ext.local_files",
            "documents-ext.seen"
          ]
        },
        "triggers": [
          {
            "kind": "manual"
          },
          {
            "kind": "schedule",
            "everyMinutes": 10
          }
        ]
      }
    },
    {
      "id": "i15",
      "parent": "i1",
      "kind": "page",
