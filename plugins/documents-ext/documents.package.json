          {
            "type": "paragraph"
          }
        ]
      },
      "flow": {
        "name": "documents.attach",
        "title": "Attach a document to a todo",
        "description": "A document attached to a todo by hand: it shows in its context and goes into what the AI reads about it (input todo, doc).",
        "inputs": [
          {
            "name": "todo",
            "type": "number"
          },
          {
            "name": "doc",
            "type": "number"
          }
