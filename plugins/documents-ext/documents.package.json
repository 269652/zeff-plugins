          }
        ]
      },
      "flow": {
        "name": "documents.pull",
        "title": "Take back the Unread box of the document inbox",
        "description": "A document ticked off (or on) in a row of the document inbox is seen (unread) — run before each read of the inbox (input rows).",
        "inputs": [
          {
            "name": "rows",
            "type": "json"
          }
        ],
        "nodes": [
          {
            "id": "plan",
            "kind": "action",
            "action": "lambda.invoke",
            "input": {
              "name": "documents.pull-plan",
              "event": {
                "rows": "{{ input.rows }}"
              }
            }
          },
          {
            "id": "wrote",
            "kind": "if",
            "when": "{{ steps.plan.statements }}",
            "then": [
              {
                "id": "write",
                "kind": "action",
                "action": "sql.exec",
                "input": {
                  "statements": "{{ steps.plan.statements }}"
                }
              }
            ],
            "else": []
          },
          {
            "id": "done",
            "kind": "return",
            "value": {
              "ok": true,
              "seen": "{{ steps.plan.seen }}",
              "unread": "{{ steps.plan.unread }}"
            }
          }
        ],
        "requested": {
          "store": [
            "documents-ext.documents",
            "documents-ext.gate",
