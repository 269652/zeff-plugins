{
  "format": 1,
  "id": "whatsapp-ext",
  "version": "1.0.0",
  "name": "WhatsApp",
  "description": "WhatsApp read into Zeff — a sync of the Sync menu.",
  "icon": "🟢",
  "localize": true,
  "items": [
    {
      "id": "i1",
      "kind": "page",
      "title": "WhatsApp",
      "icon": "🟢",
      "content": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Your chats' latest messages (WhatsApp Web's chat list — no chat opened, nothing marked read). Its sync is the flow below — a step of the Sync menu; how often it runs: the Sync settings."
              }
            ]
          }
        ]
      }
    },
    {
      "id": "i2",
      "parent": "i1",
      "kind": "page",
      "title": "Read WhatsApp",
      "icon": "⚡",
      "content": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph"
          }
        ]
      },
      "flow": {
        "name": "whatsapp.sync",
        "title": "Read WhatsApp",
        "description": "Your chats' latest messages (WhatsApp Web's chat list — no chat opened, nothing marked read).",
        "inputs": [],
        "nodes": [
          {
            "id": "read",
            "kind": "action",
            "action": "connector.sync",
            "input": {
              "source": "whatsapp",
              "by": "{{ env.trigger.kind }}"
            }
          }
        ],
        "output": "{{ steps.read }}",
        "requested": {
          "sync": [
            "whatsapp"
          ]
        },
        "triggers": [
          {
            "kind": "schedule",
            "everyMinutes": 15,
            "from": "08:00",
            "to": "19:00"
          }
        ],
        "sync": {
          "label": "WhatsApp",
          "what": "Your chats' latest messages (WhatsApp Web's chat list — no chat opened, nothing marked read).",
          "replaces": "whatsapp"
        }
      }
    }
  ]
}
