{
  "format": 1,
  "id": "teams-ext",
  "version": "1.0.0",
  "name": "Teams",
  "description": "Teams read into Zeff — a sync of the Sync menu.",
  "icon": "🟣",
  "localize": true,
  "items": [
    {
      "id": "i1",
      "kind": "page",
      "title": "Teams",
      "icon": "🟣",
      "content": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Your Teams mentions and 1:1 messages — read from Teams in the automation Chrome (its own cache, read-only). The sync is the flow below — a step of the Sync menu; how often it runs: the Sync settings. The scraper is the driver lambda teams.driver (Studio → Lambdas): when the app changes and the sync breaks, it is mended there."
              }
            ]
          }
        ]
      }
    },
    {
      "id": "i2",
      "parent": "i1",
      "kind": "page",
      "title": "Read Teams",
      "icon": "⚡",
      "content": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph"
          }
        ]
      },
      "flow": {
        "name": "teams.sync",
        "title": "Read Teams",
        "description": "Your Teams mentions and 1:1 messages — read from Teams in the automation Chrome (its own cache, read-only).",
        "inputs": [],
        "nodes": [
          {
            "id": "cfg",
            "kind": "action",
            "action": "teams.settings",
            "input": {}
          },
          {
            "id": "api",
            "kind": "if",
            "when": "steps.cfg.via == 'api'",
            "then": [
              {
                "id": "noapi",
                "kind": "return",
                "value": {
                  "ok": false,
                  "message": "Teams is read through Microsoft's API — the plugin reads through the automation Chrome only; switch the Connections page to the Chrome, or switch back."
                }
              }
            ],
            "else": []
          },
          {
            "id": "up",
            "kind": "action",
            "action": "chrome.up",
            "input": {}
          },
          {
            "id": "wait",
            "kind": "if",
            "when": "env.trigger.kind == 'schedule' and not steps.up.up",
            "then": [
              {
                "id": "later",
                "kind": "return",
                "value": {
                  "ok": true,
                  "message": "The automation Chrome isn't running — later."
                }
              }
            ],
            "else": []
          },
          {
            "id": "reading",
            "kind": "try",
            "nodes": [
              {
                "id": "read",
                "kind": "action",
                "action": "driver.call",
                "input": {
                  "name": "teams.driver",
                  "event": {
                    "tool": "read",
                    "launch": "{{ env.trigger.kind != 'schedule' }}"
                  }
                }
              }
            ],
            "catch": [
              {
                "id": "failed",
                "kind": "action",
                "action": "teams.keep",
                "input": {
                  "ok": false,
                  "message": "{{ error.message }}"
                }
              },
              {
                "id": "stop",
                "kind": "return",
                "value": {
                  "ok": false,
                  "message": "{{ error.message | truncate(300) }}"
                }
              }
            ]
          },
          {
            "id": "keep",
            "kind": "action",
            "action": "teams.keep",
            "input": {
              "messages": "{{ steps.read.messages }}"
            }
          },
          {
            "id": "done",
            "kind": "return",
            "value": "{{ steps.keep }}"
          }
        ],
        "requested": {
          "sync": [
            "teams"
          ],
          "driver": [
            "teams.driver"
          ]
        },
        "triggers": [
          {
            "kind": "schedule",
            "everyMinutes": 15,
            "from": "08:00",
            "to": "19:00"
          }
        ],
        "sync": {
          "label": "Teams",
          "what": "Your Teams mentions and 1:1 messages — read from Teams in the automation Chrome (its own cache, read-only).",
          "replaces": "teams"
        }
      }
    }
  ]
}
