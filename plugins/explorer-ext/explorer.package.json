    {
      "id": "i10",
      "parent": "i1",
      "kind": "page",
      "title": "Open a file on this computer",
      "icon": "🗂️",
      "content": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph"
          }
        ]
      },
      "flow": {
        "name": "explorer.open-here",
        "title": "Open a file on this computer",
        "description": "A file opened with this computer's program for it, or shown in Windows Explorer (input path, reveal). Output { message }.",
        "inputs": [],
        "nodes": [
          {
            "id": "do",
            "kind": "action",
            "action": "fs.open-here",
            "input": {
              "path": "{{ input.path }}",
              "reveal": "{{ input.reveal }}"
