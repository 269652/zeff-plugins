      "content": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph"
          }
        ]
      },
      "flow": {
        "name": "explorer.unwatch",
        "title": "Stop watching a folder",
        "description": "A watched folder no longer watched (input id); its documents stay. Output { message }.",
        "inputs": [],
        "nodes": [
          {
            "id": "do",
            "kind": "action",
            "action": "explorer.unwatch",
            "input": {
              "id": "{{ input.id }}"
            }
          },
          {
